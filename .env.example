# Copy this file to .env.local and fill in the values.
# `pnpm supabase status` prints the local values after `pnpm supabase start`.

# Public URL of the application (used in QR codes and invitation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Database tests (pnpm test:db). Defaults to the local Supabase database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
